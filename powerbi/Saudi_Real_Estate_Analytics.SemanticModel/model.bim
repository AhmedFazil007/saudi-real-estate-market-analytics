{
  "name": "SaudiRealEstate",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [],
    "tables": [
      {
        "name": "Transactions",
        "columns": [
          {
            "name": "transaction_id",
            "dataType": "string",
            "sourceColumn": "transaction_id",
            "summarizeBy": "none"
          },
          {
            "name": "transaction_date",
            "dataType": "dateTime",
            "sourceColumn": "transaction_date",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "city",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "property_type",
            "dataType": "string",
            "sourceColumn": "property_type",
            "summarizeBy": "none"
          },
          {
            "name": "area_sqm",
            "dataType": "double",
            "sourceColumn": "area_sqm",
            "summarizeBy": "sum"
          },
          {
            "name": "bedrooms",
            "dataType": "int64",
            "sourceColumn": "bedrooms",
            "summarizeBy": "none"
          },
          {
            "name": "property_age_years",
            "dataType": "int64",
            "sourceColumn": "property_age_years",
            "summarizeBy": "none"
          },
          {
            "name": "transaction_price_sar",
            "dataType": "double",
            "sourceColumn": "transaction_price_sar",
            "summarizeBy": "sum",
            "formatString": "#,0;(#,0);-"
          },
          {
            "name": "price_per_sqm_sar",
            "dataType": "double",
            "sourceColumn": "price_per_sqm_sar",
            "summarizeBy": "none"
          },
          {
            "name": "financing_method",
            "dataType": "string",
            "sourceColumn": "financing_method",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "YearMonth",
            "dataType": "string",
            "sourceColumn": "YearMonth",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Transactions",
            "expression": "COUNTROWS(Transactions)",
            "formatString": "#,0"
          },
          {
            "name": "Total Value SAR",
            "expression": "SUM(Transactions[transaction_price_sar])",
            "formatString": "#,0"
          },
          {
            "name": "Average Price SAR",
            "expression": "AVERAGE(Transactions[transaction_price_sar])",
            "formatString": "#,0"
          },
          {
            "name": "Median Price SAR",
            "expression": "MEDIAN(Transactions[transaction_price_sar])",
            "formatString": "#,0"
          },
          {
            "name": "Total Area Sqm",
            "expression": "SUM(Transactions[area_sqm])",
            "formatString": "#,0"
          },
          {
            "name": "Weighted SAR per Sqm",
            "expression": "DIVIDE([Total Value SAR],[Total Area Sqm])",
            "formatString": "#,0"
          },
          {
            "name": "Average Property Age",
            "expression": "AVERAGE(Transactions[property_age_years])",
            "formatString": "0.0"
          },
          {
            "name": "Average Area Sqm",
            "expression": "AVERAGE(Transactions[area_sqm])",
            "formatString": "0.0"
          },
          {
            "name": "Mortgage Transactions",
            "expression": "CALCULATE([Transactions], Transactions[financing_method] = \"Mortgage\")",
            "formatString": "#,0"
          },
          {
            "name": "Mortgage Share",
            "expression": "DIVIDE([Mortgage Transactions],[Transactions])",
            "formatString": "0.0%"
          },
          {
            "name": "Prior Year Value SAR",
            "expression": "VAR CurrentYear = SELECTEDVALUE(Transactions[Year]) RETURN IF(NOT ISBLANK(CurrentYear), CALCULATE([Total Value SAR], REMOVEFILTERS(Transactions[Year], Transactions[transaction_date], Transactions[MonthStart], Transactions[YearMonth]), Transactions[Year] = CurrentYear - 1))",
            "formatString": "#,0"
          },
          {
            "name": "YoY Value Change %",
            "expression": "DIVIDE([Total Value SAR] - [Prior Year Value SAR],[Prior Year Value SAR])",
            "formatString": "0.0%"
          }
        ],
        "partitions": [
          {
            "name": "Transactions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Headers, {{\"transaction_id\", type text}, {\"transaction_date\", type date}, {\"city\", type text}, {\"region\", type text}, {\"property_type\", type text}, {\"area_sqm\", type number}, {\"bedrooms\", Int64.Type}, {\"property_age_years\", Int64.Type}, {\"transaction_price_sar\", type number}, {\"price_per_sqm_sar\", type number}, {\"financing_method\", type text}}, \"en-US\"),",
                "    AddYear = Table.AddColumn(Types, \"Year\", each Date.Year([transaction_date]), Int64.Type),",
                "    AddMonth = Table.AddColumn(AddYear, \"MonthStart\", each Date.StartOfMonth([transaction_date]), type date),",
                "    AddYearMonth = Table.AddColumn(AddMonth, \"YearMonth\", each Date.ToText([transaction_date], \"yyyy-MM\"), type text)",
                "in",
                "    AddYearMonth"
              ]
            }
          }
        ]
      }
    ]
  }
}